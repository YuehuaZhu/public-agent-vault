{
  "rules": [
    {"name": "openai-key", "pattern": "sk-[A-Za-z0-9]{20,}", "replacement": "[REDACTED:openai-key]"},
    {"name": "anthropic-key", "pattern": "sk-ant-[A-Za-z0-9_-]+", "replacement": "[REDACTED:anthropic-key]"},
    {"name": "github-pat-classic", "pattern": "ghp_[A-Za-z0-9]{20,}", "replacement": "[REDACTED:github-pat]"},
    {"name": "github-pat-fine", "pattern": "github_pat_[A-Za-z0-9_]{20,}", "replacement": "[REDACTED:github-pat]"},
    {"name": "github-oauth", "pattern": "gho_[A-Za-z0-9]{20,}", "replacement": "[REDACTED:github-oauth]"},
    {"name": "google-api-key", "pattern": "AIza[A-Za-z0-9_-]{20,}", "replacement": "[REDACTED:google-api-key]"},
    {"name": "aws-access-key", "pattern": "AKIA[A-Z0-9]{16}", "replacement": "[REDACTED:aws-access-key]"},
    {"name": "bearer-token", "pattern": "(?i)Bearer\\s+[A-Za-z0-9._~+/=-]{16,}", "replacement": "Bearer [REDACTED]"},
    {"name": "email", "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "replacement": "[REDACTED:email]"}
  ]
}
